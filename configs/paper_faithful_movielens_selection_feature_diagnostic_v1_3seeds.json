{
  "dataset": {
    "name": "movielens-100k",
    "raw_dir": "data/raw/ml-100k",
    "network_mode": "gcmc_features",
    "network_embedding_mode": "user_features"
  },
  "output_prefix": "paper_faithful_movielens_selection_feature_diagnostic_v1_3seeds",
  "variants": [
    {
      "label": "schur_loglambda_tuned_standard_topk",
      "policy": "paper_faithful_dunet"
    },
    {
      "label": "schur_fixed_lambda_0p3",
      "policy": "paper_faithful_dunet",
      "acquisition_overrides": {
        "lambda_entropy": 0.3,
        "paper_tuning_frequency": 0
      }
    },
    {
      "label": "schur_entropy_only",
      "policy": "paper_faithful_dunet_no_reward",
      "acquisition_overrides": {
        "paper_tuning_frequency": 0
      }
    },
    {
      "label": "linucb_concat",
      "policy": "linucb_concat",
      "acquisition_overrides": {
        "selection": "topk"
      }
    },
    {
      "label": "linucb_mf_interaction",
      "policy": "linucb_mf_interaction",
      "acquisition_overrides": {
        "selection": "topk"
      }
    }
  ],
  "seeds": [0, 1, 2],
  "split": {
    "mode": "movielens_u1_fallback_table1_density",
    "num_users": 943,
    "num_items": 1681,
    "initial_size": 1364
  },
  "mf": {
    "rank": 20,
    "epochs": 20,
    "learning_rate": 0.015,
    "regularization": 0.06,
    "algorithm": "svdpp"
  },
  "acquisition": {
    "cycles": 20,
    "batch_size": 100,
    "lambda_entropy": 1.0,
    "diffusion_prob": 0.0,
    "sigma": 0.4,
    "dls_top_k": 20,
    "dls_neighbor_mode": "graph_edges",
    "paper_dls_scope": "full",
    "selection": "topk",
    "selection_temperature": 1.0,
    "rating_midpoint": 3.0,
    "entropy_mode": "schur_conditional_variance",
    "entropy_score_transform": "none",
    "entropy_logdet_regularization": 1.0,
    "paper_entropy_correction_weight": 1.0,
    "paper_entropy_shortlist_size": 20000,
    "paper_entropy_batch_size": 4096,
    "sigma_grid": [0.1, 0.2, 0.4, 0.8, 1.6],
    "adaptive_lambda_grid": [0.0, 0.1, 1.0, 3.0, 10.0, 30.0, 100.0, 300.0],
    "adaptive_diffusion_prob_grid": [0.0],
    "paper_tuning_frequency": 5,
    "paper_tuning_metric": "standard_mask_rmse",
    "ucb_alpha": 0.8,
    "ucb_regularization": 1.0
  }
}
